# Hive environment variables — reference only.
#
# NOTE: nothing auto-loads a root .env file. The daemon and scripts read
# these from the process environment, so export them in your shell, your
# service definition (launchd/systemd plist), or the command line.
# The dashboard reads NEXT_PUBLIC_* at build time; deploy-vercel.sh
# passes NEXT_PUBLIC_WS_URL automatically.

# ── Daemon (process environment) ──────────────────────────────────
# SEND_RETURN_BIN=/path/to/send-return   # auto-pilot keystroke binary (default: ~/send-return)
# HIVE_HOME=/custom/home                 # overrides HOME for ~/.hive resolution (tests/audit)
# ANTHROPIC_API_KEY=sk-ant-...           # enables AI suggestions (or put the key in ~/.hive/anthropic-key)

# ── Hook setup (read by setup-hooks.sh at install time) ───────────
# HIVE_DAEMON_URL=http://localhost:3001  # daemon endpoint baked into ~/.claude/settings.json hooks
# HIVE_AUTO_APPROVE=1                    # 1 = install the machine-wide auto-approve hook, 0 = skip/remove it

# ── Installer (read by scripts/install.sh in non-interactive mode) ─
# HIVE_PRIMARY_URL=wss://...             # join an existing Hive as a satellite
# HIVE_PRIMARY_TOKEN=<64-char-hex>       # token from the primary machine

# ── Dashboard build (apps/dashboard, build-time) ──────────────────
# NEXT_PUBLIC_WS_URL=wss://your-tunnel.example.com      # set by deploy-vercel.sh from the tunnel URL
# NEXT_PUBLIC_DASHBOARD_URL=https://your-app.vercel.app # used in invite links

# ── Deploy script (scripts/deploy-vercel.sh) ──────────────────────
# HIVE_CLEAR_REPO_HOMEPAGE=1             # maintainer-only: clear the GitHub repo homepage after deploy
